layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="neovim" split_direction="vertical" {
        pane command="nvim"
    }
    tab name="lazygit" split_direction="vertical" {
        pane command="lazygit"
    }
    tab name="fish" split_direction="vertical" {
        pane command="fish"
    }
    tab name="live-server" split_direction="vertical" {
        pane command="fish"
    }
    tab name="llm" split_direction="vertical" start_suspended=true {
        pane command="fish"
    }
}

